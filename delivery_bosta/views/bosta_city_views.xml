<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bosta_city_list" model="ir.ui.view">
        <field name="name">bosta.city.list</field>
        <field name="model">bosta.city</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="name_ar"/>
                <field name="code"/>
                <field name="state_ids" widget="many2many_tags"/>
                <field name="bosta_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bosta_city" model="ir.actions.act_window">
        <field name="name">Bosta Cities</field>
        <field name="res_model">bosta.city</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import cities from a Bosta delivery method</p>
            <p>Each Egyptian governorate needs a Bosta city before shipments to it can be booked.</p>
        </field>
    </record>

    <record id="view_country_state_bosta" model="ir.ui.view">
        <field name="name">res.country.state.list.bosta</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="base.view_country_state_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="bosta_city_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_bosta_city" name="Bosta Cities" parent="stock.menu_stock_config_settings"
              action="action_bosta_city" sequence="60" groups="stock.group_stock_manager"/>
</odoo>
